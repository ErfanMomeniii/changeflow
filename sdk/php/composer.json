{
    "name": "changeflow/changeflow",
    "description": "Read-only access to changeflow's replication state, for application and admin tooling",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Changeflow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Changeflow\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
